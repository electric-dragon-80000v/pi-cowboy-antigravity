{
  "name": "pi-cowboy-antigravity",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "description": "Antigravity CLI harness plugin for pi-cowboy",
  "keywords": [
    "pi-package",
    "pi",
    "pi-cowboy",
    "pi-cowboy-plugin",
    "antigravity",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "author": "electric-dragon-80000v",
  "homepage": "https://github.com/electric-dragon-80000v/pi-cowboy-antigravity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electric-dragon-80000v/pi-cowboy-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/electric-dragon-80000v/pi-cowboy-antigravity/issues"
  },
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=12"
  },
  "files": [
    "index.js",
    "plugin.js",
    "README.md",
    "LICENSE"
  ],
  "pi-cowboy": {
    "plugin": "./plugin.js"
  },
  "scripts": {
    "test": "node --test index.test.js",
    "syntax:check": "node --check index.js && node --check plugin.js && node --check index.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:install": "pi install .",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:stage": "npm stage publish",
    "release:approve": "scripts/publish.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9"
  }
}
